# Copy to .env and fill in from your Supabase dashboard. Never commit .env.

# Connect > "Session pooler" connection string (includes the database password).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Project Settings > API > Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Only if your project still uses the legacy JWT secret (Project Settings > JWT Keys).
# Leave unset for projects on the newer signing keys.
# SUPABASE_JWT_SECRET=
